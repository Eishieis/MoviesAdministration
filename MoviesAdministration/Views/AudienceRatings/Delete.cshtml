@model MoviesAdministration.Models.AudienceRating

@{
    ViewData["Title"] = "Delete Audience Rating";
}

<div class="container py-4">

    <h1>Delete Audience Rating</h1>

    <p class="text-danger">
        Are you sure you want to delete this audience rating?
    </p>

    <div class="card shadow-sm">
        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-3">Rating ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Rating Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>
            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                <button type="submit" class="btn btn-danger">
                    Delete Rating
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>