@model MoviesAdministration.Models.Genre

@{
    ViewData["Title"] = "Genre Details";
}

<div class="container py-4">

    <h1>Genre Details</h1>
    <p class="text-muted">View information about this movie genre.</p>

    <div class="card shadow-sm">
        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-3">Genre ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Genre Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>
            </dl>

            <a asp-action="Edit"s
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit Genre
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to List
            </a>

        </div>
    </div>

</div>