@model IEnumerable<MoviesAdministration.Models.Genre>

@{
    ViewData["Title"] = "Genres";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Movie Genres</h1>
            <p>Manage your FreshPotatoes movie genres.</p>
        </div>

        <a href="@Url.Action("Create", "Genres")"
           class="btn btn-success">
            + Add New Genre
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <p class="text-muted">No genres have been added yet.</p>
            }
            else
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Genre Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var genre in Model)
                        {
                            <tr>
                                <td>@genre.Id</td>
                                <td>@genre.Name</td>
                                <td>
                                    <a href="@Url.Action("Details", "Genres", new { id = genre.Id })"
                                       class="btn btn-primary btn-sm">View</a>

                                    <a href="@Url.Action("Edit", "Genres", new { id = genre.Id })"
                                       class="btn btn-warning btn-sm">Edit</a>

                                    <a href="@Url.Action("Delete", "Genres", new { id = genre.Id })"
                                       class="btn btn-danger btn-sm">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </div>
    </div>
</div>