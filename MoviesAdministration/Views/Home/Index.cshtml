@{
    ViewData["Title"] = "FreshPotatoes";
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="home-page">
    <div class="container home-container">

        <section class="home-card">

            <div class="home-visual">
                <img src="~/images/logo.png"
                     alt="FreshPotatoes cinema background"
                     class="home-background-image" />

                <div class="home-image-label">
                    THE FRESHEST POTATO IN CINEMA HISTORY
                </div>
            </div>

            <div class="home-content">

                <div class="home-brand">
                    <span class="potato-mark">🥔</span>
                    <span>FreshPotatoes</span>
                </div>

                <div class="home-divider"></div>

                <h1>Movie Database</h1>

                <p class="home-description">
                    Your collection of movies, organized in one place.
                   
                </p>

                <a asp-controller="Movies"
                   asp-action="Index"
                   class="btn browse-movies-btn">
                    Browse Movie Collection
                    <span class="browse-arrow" aria-hidden="true">&rarr;</span>
                </a>

                <div class="home-caption">
                    MOVIE DATABASE ADMINISTRATION
                </div>

            </div>

        </section>

        <div class="home-footer">
            <span>FreshPotatoes</span>
           
        </div>

    </div>
</div>