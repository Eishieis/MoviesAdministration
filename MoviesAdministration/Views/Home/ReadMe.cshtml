@{
    ViewData["Title"] = "README";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">Movies Review</h1>
        <p class="lead">
            The perfect place for movie lovers.
        </p>
    </div>

    <div class="mb-5">
        <h2>About this page</h2>
        <p>
            Movies Review is a web application developed using ASP.NET Core MVC and C#.
            The application is designed to allow users to explore movies, view movie
            information, and share reviews. It also provides movie administration
            features for managing the movie collection.
        </p>
    </div>

    <div class="mb-5">
        <h2>Francis' MovieAdmin Features</h2>
        <ul>
            <li>Browse movies</li>
            <li>View detailed movie information</li>
            <li>Add new movies</li>
            <li>Edit existing movie information</li>
            <li>Delete movies from the collection</li>
            <li>Search for movies</li>
            <li>Read and manage movie reviews</li>
            
        </ul>
    </div>

