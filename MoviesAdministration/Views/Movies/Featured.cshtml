<style>
    body {
        background-color: #f4efe3;
        color: #292725;
    }

    .featured-page {
        padding: 45px 0 70px;
    }

    .featured-header {
        background: linear-gradient(135deg, #b83227, #d94a3d);
        color: white;
        padding: 45px;
        border-radius: 24px;
        margin-bottom: 35px;
        text-align: center;
        box-shadow: 0 12px 30px rgba(90, 45, 35, 0.15);
    }

        .featured-header h1 {
            margin: 0;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 48px;
        }

        .featured-header p {
            margin-top: 12px;
            font-size: 17px;
        }

    .featured-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .featured-card {
        background: #fffdf8;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #e7decd;
        box-shadow: 0 8px 25px rgba(70, 55, 40, 0.08);
    }

        .featured-card img {
            width: 100%;
            height: 380px;
            object-fit: cover;
            display: block;
        }

    .featured-content {
        padding: 25px;
        text-align: center;
    }

        .featured-content h2 {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 28px;
            margin-bottom: 10px;
        }

        .featured-content p {
            color: #66605a;
            line-height: 1.6;
        }

    .featured-label {
        display: inline-block;
        background-color: #edf2e8;
        color: #4d654a;
        padding: 6px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 12px;
    }

    .back-button {
        margin-top: 35px;
        text-align: center;
    }

        .back-button a {
            background-color: #b83227;
            border-color: #b83227;
            color: white;
            border-radius: 10px;
            padding: 11px 22px;
            font-weight: bold;
        }
</style>

<div class="container featured-page">

    <div class="featured-header">

        <h1>FreshPotatoes Featured Movies</h1>

        <p>
            Hand-picked favorites from the FreshPotatoes cinema collection.
        </p>

    </div>

    <div class="featured-grid">

        <div class="featured-card">

            <img src="~/images/spidey.jpg"
                 alt="Spider-Man: Brand New Day">

            <div class="featured-content">

                <span class="featured-label">
                    Featured Pick
                </span>

                <h2>Spider-Man: Brand New Day</h2>

                <p>
                    Peter Parker returns for a new adventure as Spider-Man.
                </p>

            </div>

        </div>

        <div class="featured-card">

            <img src="~/images/batman.jpg"
                 alt="The Batman">

            <div class="featured-content">

                <span class="featured-label">
                    Featured Pick
                </span>

                <h2>The Batman</h2>

                <p>
                    Batman investigates crime and corruption in Gotham City.
                </p>

            </div>

        </div>

        <div class="featured-card">

            <img src="~/images/obsession.jpeg"
                 alt="Obsession">

            <div class="featured-content">

                <span class="featured-label">
                    Featured Pick
                </span>

                <h2>Obsession</h2>

                <p>
                    A psychological horror story about obsession and fear.
                </p>

            </div>

        </div>

    </div>

    <div class="back-button">

        <a asp-action="Index" class="btn">
            Back to Movie List
        </a>

    </div>

</div>