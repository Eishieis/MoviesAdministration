@model List<MoviesAdministration.Models.Movie>

@{
    bool openCreate = ViewBag.OpenCreate is bool value && value;
}

<link rel="stylesheet" href="~/css/movies.css" asp-append-version="true" />

<div class="container-fluid px-3 px-lg-4 py-4 movie-index"
     data-open-create="@openCreate.ToString().ToLowerInvariant()">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="text-uppercase text-muted small fw-semibold mb-1">
                FreshPotatoes / Database
            </div>
            <h1 class="h3 mb-1">Movie Collection</h1>
            <p class="text-muted mb-0">View and manage movie records.</p>
        </div>

        <button type="button"
                class="btn btn-primary js-movie-modal"
                data-modal-type="create"
                data-modal-url="@Url.Action("Create", "Movies")">
            Add Movie
        </button>
    </div>

    <div id="movie-list-container">
        <div class="text-muted small mb-3">
            Total records: @Model.Count
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">
                No movies have been added to the database yet.
            </div>
        }
        else
        {
            <div class="table-responsive border rounded bg-white">
                <table class="table table-striped table-hover align-middle mb-0 movie-table">
                    <thead class="table-light">
                        <tr>
                            <th>Poster</th>
                            <th>Title</th>
                            <th>Genre</th>
                            <th>Rating</th>
                            <th>Runtime</th>
                            <th>Release Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var movie in Model)
                        {
                            string image;

                            if (movie.Title.Contains("Spider-Man", StringComparison.OrdinalIgnoreCase))
                            {
                                image = "spidey.jpg";
                            }
                            else if (movie.Title.Contains("Batman", StringComparison.OrdinalIgnoreCase))
                            {
                                image = "batman.jpg";
                            }
                            else if (movie.Title.Contains("Obsession", StringComparison.OrdinalIgnoreCase))
                            {
                                image = "obsession.jpeg";
                            }
                            else
                            {
                                image = "movies1.jpg";
                            }

                            string imageUrl;

                            if (!string.IsNullOrWhiteSpace(movie.ImageBlobName))
                            {
                                imageUrl = Url.Action(
                                    "Image",
                                    "Movies",
                                    new { blobName = movie.ImageBlobName }
                                ) ?? Url.Content($"~/images/{image}");
                            }
                            else
                            {
                                imageUrl = Url.Content($"~/images/{image}");
                            }

                            <tr>
                                <td>
                                    <img src="@imageUrl"
                                         alt="@movie.Title poster"
                                         class="movie-thumbnail" />
                                </td>

                                <td class="fw-semibold">@movie.Title</td>
                                <td>@movie.Genre</td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @movie.Rating
                                    </span>
                                </td>

                                <td>@movie.RuntimeHours h @movie.RuntimeMinutes min</td>

                                <td>@movie.ReleaseDate.ToString("MMM dd, yyyy")</td>

                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="button"
                                                class="btn btn-primary btn-sm js-movie-modal"
                                                data-modal-type="view"
                                                data-modal-url="@Url.Action("DetailsModal", "Movies", new { id = movie.Id })">
                                            View
                                        </button>

                                        <button type="button"
                                                class="btn btn-warning btn-sm js-movie-modal"
                                                data-modal-type="edit"
                                                data-modal-url="@Url.Action("Edit", "Movies", new { id = movie.Id })">
                                            Edit
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm js-movie-modal"
                                                data-modal-type="delete"
                                                data-modal-url="@Url.Action("Delete", "Movies", new { id = movie.Id })">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="modal fade"
     id="movieModal"
     tabindex="-1"
     aria-labelledby="movieModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content" id="movieModalContent">
            <div class="modal-body p-4">Loading...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/movies.js" asp-append-version="true"></script>
}