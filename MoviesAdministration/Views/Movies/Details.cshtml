@model MoviesAdministration.Models.Movie

<style>
    body {
        background-color: Gray;
    }

    .details-page {
        padding: 40px 0;
    }

    .details-card {
        display: flex;
        gap: 35px;
        background-color: white;
        padding: 35px;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    .details-poster {
        width: 250px;
        height: 360px;
        object-fit: cover;
        border-radius: 10px;
    }

    .details-info {
        flex: 1;
    }

        .details-info h1 {
            color: #d32f2f;
            font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
            font-size: 42px;
            letter-spacing: 2px;
            margin-top: 0;
        }

        .details-info p {
            font-size: 17px;
        }

    .details-buttons {
        margin-top: 25px;
    }
</style>

<div class="container details-page">

    <div class="details-card">

        @{
            string image = Model.Title switch
            {
                "Spider-Man: Brand New Day" => "spidey.jpg",
                "The Batman" => "batman.jpg",
                "Obsession" => "obsession.jpeg",
                _ => "movies1.jpg"
            };
        }

        <img src="~/images/@image"
             class="details-poster"
             alt="@Model.Title" />

        <div class="details-info">

            <h1>@Model.Title</h1>

            <p>
                <strong>Synopsis:</strong>
                @Model.Synopsis
            </p>

            <p>
                <strong>Genre:</strong>
                @Model.Genre
            </p>

            <p>
                <strong>Rating:</strong>
                @Model.Rating
            </p>

            <p>
                <strong>Runtime:</strong>
                @Model.RuntimeHours hour(s)
                @Model.RuntimeMinutes minute(s)
            </p>

            <p>
                <strong>Release Date:</strong>
                @Model.ReleaseDate.ToString("MMMM dd, yyyy")
            </p>

            <div class="details-buttons">

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to Movies
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    Edit
                </a>

            </div>

        </div>

    </div>

</div>