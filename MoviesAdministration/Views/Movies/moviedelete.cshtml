@model MoviesAdministration.Models.Movie

<div class="modal-header">
    <div>
        <div class="text-muted small">FreshPotatoes / Database</div>
        <h2 class="modal-title fs-5" id="movieModalLabel">Delete Movie</h2>
    </div>

    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close">
    </button>
</div>

<form asp-controller="Movies"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post"
      class="js-modal-form">

    <div class="modal-body">

        <p>Are you sure you want to delete this movie?</p>

        <div class="alert alert-warning mb-0">
            <div class="fw-semibold">@Model.Title</div>
            <div class="small mt-1">
                This action cannot be undone.
            </div>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-danger">
            Delete Movie
        </button>
    </div>

</form>